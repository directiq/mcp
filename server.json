{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.directiq.mcp/directiq",
  "title": "DirectIQ",
  "description": "Manage DirectIQ contacts, lists and tags, see campaign results, and send transactional email.",
  "version": "0.2.0",
  "websiteUrl": "https://www.directiq.com/mcp-setup/",
  "repository": {
    "url": "https://github.com/directiq/mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/directiq/mcp/main/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://www.directiq.com/img/directiq-logo.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.directiq.com/mcp",
      "headers": [
        {
          "name": "x-api-key",
          "description": "DirectIQ API key (Dashboard > Settings > API Keys)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
